# ============================================================
# Railway Environment Variables for Slekco Laravel Backend
# Set these in Railway dashboard: Project > Variables
# ============================================================

APP_NAME=Slekco
APP_ENV=production
APP_DEBUG=false
# APP_KEY is auto-generated on first boot by railway-start.sh,
# but you can also set it manually with: php artisan key:generate --show
APP_KEY=

# Railway provides the public URL; set it after first deploy
APP_URL=https://your-app.up.railway.app

# ---- Database ----
# Railway MySQL plugin exposes these. Reference them like below,
# OR paste the actual values from the MySQL service "Variables" tab.
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# ---- CORS ----
# Comma-separated list of allowed frontend origins (your Vercel URL).
# No trailing slash. Example for multiple: https://a.vercel.app,https://b.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# ---- Sessions / Cache / Queue (file-based, no extra services needed) ----
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
